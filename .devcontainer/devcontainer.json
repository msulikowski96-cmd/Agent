{
  "name": "Pulpit Linux w przeglądarce",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Pulpit (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
